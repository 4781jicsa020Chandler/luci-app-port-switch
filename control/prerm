#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
if [ -f /etc/port-switch/pending/token ]; then
    token=$(cat /etc/port-switch/pending/token)
    case "$token" in
        ''|*[!0-9a-f]*) exit 1 ;;
        *)
            [ "${#token}" = 32 ] || exit 1
            /usr/libexec/port-switch rollback "$token" >/dev/null 2>&1 || exit 1
            ;;
    esac
fi
/etc/init.d/port-switch disable
rm -f /tmp/luci-indexcache
rm -rf /tmp/luci-modulecache
exit 0
